# ==============================================================================
# EHRJ DIGITAL CAMPUS & ERP — DEVELOPMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development.
# ==============================================================================

# 1. RUNTIME & PORTS
NODE_ENV=development
PORT=3000

# 2. CANONICAL APP URL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. CRYPTOGRAPHIC SECRETS (Development defaults permitted)
JWT_SECRET=ehrj-madrasa-digital-campus-secure-production-jwt-secret-key-2026
CRON_SECRET=ehrj-internal-cron-token
WEBHOOK_SIGNING_SECRET=ehrj_demo_webhook_secret_2026

# 4. LOCAL DATABASE
DATABASE_URL=file:./dev.db

# 5. PAYMENT GATEWAYS (SANDBOX / MOCK MODE)
BKASH_MODE=SANDBOX
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=sandbox_bkash_key
BKASH_APP_SECRET=sandbox_bkash_secret
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password
BKASH_WEBHOOK_SECRET=ehrj_demo_webhook_secret_2026

NAGAD_MODE=SANDBOX
NAGAD_BASE_URL=https://api.sandbox.nagad.com.bd
NAGAD_MERCHANT_ID=EHRJ_NAGAD_01

# 6. COMMUNICATION (SIMULATION / LOCAL TESTING)
SMTP_USER=ehrjmadrasha@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_MOCK=true

SMS_GATEWAY_PROVIDER=MOCK
SMS_API_KEY=mock-sms-key
SMS_SENDER_ID=EHRJ
SMS_MOCK=true

# 7. ADMIN CONTACT
ADMIN_EMAIL=admin@ehrj.edu.bd
