# ─── HTTP → HTTPS Redirect ───────────────────────────
server {
    listen 80;
    server_name madrasha.example.com; # Replace with actual domain
    return 301 https://$host$request_uri;
}

# ─── Main HTTPS Server Block ─────────────────────────
server {
    listen 443 ssl http2;
    server_name madrasha.example.com; # Replace with actual domain

    # SSL Certificates (Use Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/madrasha.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/madrasha.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # ─── Security Headers ────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ─── File Upload Size Limit (match backend's 10MB body limit) ─
    client_max_body_size 10m;

    # ─── Frontend (Next.js) ──────────────────────────
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ─── Backend API (Express) ───────────────────────
    location /api/ {
        proxy_pass http://localhost:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Required for rate limiting to see real client IPs
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ─── Static Uploads ──────────────────────────────
    location /uploads/ {
        proxy_pass http://localhost:3001/uploads/;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # ─── Block dot files (.env, .git, etc.) ──────────
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
