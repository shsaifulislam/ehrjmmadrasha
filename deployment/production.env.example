# =================================================================
# EHRJ MADRASHA ERP — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Institution: Eliotganj Hazi Rohmatollah Jamiria Madrasha
# IMPORTANT: DO NOT COMMIT REAL PRODUCTION PASSWORDS TO GIT.
# =================================================================

# 1. CORE APPLICATION RUNTIME
NODE_ENV=production
PORT=3000
APP_URL=https://www.ehrjmadrasha.com
NEXT_PUBLIC_APP_URL=https://www.ehrjmadrasha.com
NEXT_PUBLIC_APP_NAME="ইলিয়টগঞ্জ হাজী রহমাতুল্লাহ্ জমিরীয়া মাদরাসা"

# 2. DATABASE PERSISTENCE
# Active schema provider is SQLite. Ensure the target directory is writable.
DATABASE_URL="file:./prisma/prod.db"
# NOTE: If migrating to external PostgreSQL in future phases:
# 1) Update `provider = "postgresql"` in prisma/schema.prisma
# 2) Re-run `npx prisma generate` and `npx prisma db push`
# 3) Provide connection string: DATABASE_URL="postgresql://ehrj_admin:STRONG_PASSWORD@localhost:5432/ehrj_prod?schema=public"

# 3. AUTHENTICATION & SECURITY SECRET
# Mandatory in production: MUST be unique and at least 32 characters long.
# Generate strong 64-character hex key via: openssl rand -hex 32
JWT_SECRET="GENERATE_UNIQUE_STRONG_64_CHAR_HEX_KEY"

# 4. INSTITUTIONAL SMTP EMAIL CREDENTIALS
# Used for parent notifications, admission receipts, and system alerts.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="info@ehrjmadrasha.com"
SMTP_PASS="ENTER_APP_SPECIFIC_SMTP_PASSWORD"
SMTP_FROM="ইলিয়টগঞ্জ মাদরাসা অফিসিয়াল <info@ehrjmadrasha.com>"

# 5. ONLINE PAYMENT GATEWAY (BKASH / NAGAD)
# Configured and managed via the Admin Integration Hub (/admin/integrations).
BKASH_APP_KEY="ENTER_OFFICIAL_BKASH_APP_KEY"
BKASH_APP_SECRET="ENTER_OFFICIAL_BKASH_APP_SECRET"
BKASH_USERNAME="ENTER_OFFICIAL_BKASH_USERNAME"
BKASH_PASSWORD="ENTER_OFFICIAL_BKASH_PASSWORD"
BKASH_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"

# 6. COMMUNICATION CHANNELS POLICY
# INSTITUTIONAL INVARIANT: STRICTLY NO SMS.
# All broadcasts are dispatched via in-app portal alerts and transactional SMTP email.
# No SMS gateway credentials or subscriptions are required.

# 7. AUTOMATED CRON & WEBHOOK SECURITY KEYS
# Mandatory for automated background cron maintenance and payment webhook callbacks.
CRON_SECRET="GENERATE_RANDOM_CRON_AUTH_TOKEN"
WEBHOOK_SIGNING_SECRET="GENERATE_HMAC_SHA256_WEBHOOK_SIGNING_SECRET"
