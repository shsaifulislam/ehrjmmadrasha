# ==============================================================================
# EHRJ DIGITAL CAMPUS & ERP — PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.production' on your production server.
# Ensure file permissions are restricted: chmod 600 .env.production
# ==============================================================================

# 1. CORE RUNTIME ENVIRONMENT
NODE_ENV=production
PORT=3000

# 2. CANONICAL APPLICATION DOMAIN & URLS
# Mandatory: Must use HTTPS in production. No trailing slash!
APP_URL=https://www.ehrjmadrasha.com
NEXT_PUBLIC_APP_URL=https://www.ehrjmadrasha.com

# 3. HIGH-ENTROPY CRYPTOGRAPHIC SECRETS
# Mandatory: Minimum 32 characters. Generate using: `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS_LONG

# Secret token required to trigger automated cron endpoints (/api/cron/*)
# Generate using: `openssl rand -hex 24`
CRON_SECRET=CHANGE_ME_TO_A_PRIVATE_CRON_BEARER_TOKEN

# HMAC SHA-256 secret for validating inbound payment webhooks
# Generate using: `openssl rand -hex 32`
WEBHOOK_SIGNING_SECRET=CHANGE_ME_TO_A_SHARED_HMAC_WEBHOOK_SECRET

# 4. DATABASE & PERSISTENCE
# SQLite file storage location. Ensure the hosting user has read/write permissions.
DATABASE_URL=file:/var/lib/ehrj/data/prod.db

# 5. PAYMENT GATEWAY: bKASH MERCHANT CHECKOUT (v1.2.0-beta)
# Set to 'PRODUCTION' when live credentials are issued by bKash PGW Team
BKASH_MODE=PRODUCTION
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_live_bkash_app_key_here
BKASH_APP_SECRET=your_live_bkash_app_secret_here
BKASH_USERNAME=your_live_bkash_merchant_username
BKASH_PASSWORD=your_live_bkash_merchant_password
BKASH_WEBHOOK_SECRET=your_bkash_inbound_webhook_secret

# 6. PAYMENT GATEWAY: NAGAD MERCHANT CHECKOUT
# Set to 'PRODUCTION' when live merchant keys are issued by Nagad
NAGAD_MODE=PRODUCTION
NAGAD_BASE_URL=https://api.nagad.com.bd
NAGAD_MERCHANT_ID=your_live_nagad_merchant_id
NAGAD_PUBLIC_KEY=your_nagad_pg_public_key_pem
NAGAD_PRIVATE_KEY=your_nagad_merchant_private_key_pem

# 7. EMAIL COMMUNICATIONS (SMTP / GMAIL APP PASSWORD)
# For automated fee receipts, guardian alerts, and admin notices
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ehrjmadrasha@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_FROM="এলিওটগঞ্জ রাজেন্দ্রপুর জামিরিয়া মাদরাসা <no-reply@ehrjmadrasha.com>"
SMTP_MOCK=false

# 8. SMS GATEWAY (BANGLADESH TELECOM / BULK SMS)
# Supports Greenweb / SSLWireless / BulkSMSBD / MimSMS
SMS_GATEWAY_PROVIDER=GREENWEB
SMS_API_KEY=your_bangladesh_sms_gateway_api_key
SMS_SENDER_ID=EHRJ_MADRASA
SMS_MOCK=false

# 9. DISASTER RECOVERY & BACKUPS
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_DIR=/var/lib/ehrj/backups
# Optional: Remote Cloud Backup Target (S3 / SFTP)
# BACKUP_S3_BUCKET=ehrj-backups-secure
# BACKUP_S3_REGION=ap-southeast-1
# BACKUP_S3_ACCESS_KEY=...
# BACKUP_S3_SECRET_KEY=...

# 10. ADMINISTRATIVE CONTACT
ADMIN_EMAIL=admin@ehrjmadrasha.com
