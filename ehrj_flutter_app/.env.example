# EHRJ Flutter Application Environment Configuration
# Copy this file to .env and adjust values for local development or production.

# Base URL of the EHRJ Madrasha Next.js ERP
# For Web/Windows: http://localhost:3000
# For Android Emulator: http://10.0.2.2:3000
# For Physical Android Device on same Wi-Fi: http://<YOUR_COMPUTER_IP>:3000
EHRJ_API_BASE_URL=http://localhost:3000

# Connection timeouts in milliseconds
EHRJ_CONNECT_TIMEOUT_MS=10000
EHRJ_RECEIVE_TIMEOUT_MS=10000

# Cache duration for academic rosters in minutes
EHRJ_ROSTER_CACHE_MINUTES=1440
