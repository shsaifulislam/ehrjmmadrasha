# ─── EHRJ Madrasha ERP — Environment Variables ──────
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ehrjmadrasha_erp"

# JWT Authentication
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_STRING_64_CHARS_MIN"
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_DIFFERENT_STRONG_RANDOM_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="production"
FRONTEND_URL="https://www.ehrjmadrasha.com"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="5242880"

# SMS Provider (bulksmsbd | teletalk | mock)
# WARNING: mock is NOT allowed in production
SMS_PROVIDER="bulksmsbd"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# bKash Payment Gateway (Optional)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_API_URL=""

# Nagad Payment Gateway (Optional)
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""
NAGAD_API_URL=""
