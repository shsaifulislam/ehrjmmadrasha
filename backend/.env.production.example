# PostgreSQL Connection String
DATABASE_URL="postgresql://madrasha_user:strongpassword@localhost:5432/madrasha_db?schema=public"

# JWT Secret (Generate a strong random string)
# Command: openssl rand -base64 32
JWT_SECRET="YOUR_SUPER_SECRET_PRODUCTION_KEY_DO_NOT_SHARE"

# Server Port
PORT=3001

# Environment
NODE_ENV="production"

# Frontend URL for CORS
FRONTEND_URL="https://madrasha.yourdomain.com"
