{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "noImplicitAny": false,
    "types": ["node"],
    "resolveJsonModule": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "scripts/**/*"]
}
