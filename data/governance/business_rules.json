[
  {
    "ruleId": "RULE-ADM-001",
    "version": "1.0",
    "nameBn": "ভর্তি অনুমোদন পরবর্তী স্বয়ংক্রিয় প্রসেসিং",
    "nameEn": "Post-Admission Approval Processing",
    "domain": "ADMISSION",
    "triggerEvent": "ADMISSION_APPROVED",
    "conditions": [
      {
        "field": "payload.studentId",
        "operator": "EXISTS",
        "value": null
      },
      {
        "field": "payload.status",
        "operator": "EQUALS",
        "value": "APPROVED"
      }
    ],
    "actions": [
      {
        "actionType": "DISPATCH_NOTIFICATION",
        "target": "GUARDIAN",
        "parameters": {
          "template": "ADMISSION_APPROVED"
        },
        "isHighRisk": false
      },
      {
        "actionType": "ENQUEUE_JOB",
        "target": "CREATE_ADMISSION_INVOICE",
        "parameters": {
          "autoGenerate": true
        },
        "isHighRisk": false
      }
    ],
    "riskLevel": "MEDIUM",
    "requiresApproval": false,
    "status": "ACTIVE",
    "createdAt": "2026-09-29T00:00:00.000Z",
    "updatedAt": "2026-09-29T00:00:00.000Z",
    "createdBy": "SYSTEM_INIT"
  },
  {
    "ruleId": "RULE-ATT-001",
    "version": "1.0",
    "nameBn": "টানা অনুপস্থিতি উপস্থিতি সতর্কতা ও নোটিফিকেশন",
    "nameEn": "Consecutive Absence Early Warning",
    "domain": "ATTENDANCE",
    "triggerEvent": "ATTENDANCE_SAVED",
    "conditions": [
      {
        "field": "payload.consecutiveAbsences",
        "operator": "GREATER_THAN_OR_EQUAL",
        "value": 3
      }
    ],
    "actions": [
      {
        "actionType": "CREATE_EARLY_WARNING",
        "target": "ATTENDANCE_ENGINE",
        "parameters": {
          "ruleCode": "EW-ATT-001",
          "severity": "WARNING"
        },
        "isHighRisk": false
      },
      {
        "actionType": "DISPATCH_NOTIFICATION",
        "target": "GUARDIAN",
        "parameters": {
          "template": "ATTENDANCE_WARNING",
          "throttleMinutes": 1440
        },
        "isHighRisk": false
      }
    ],
    "riskLevel": "MEDIUM",
    "requiresApproval": false,
    "status": "ACTIVE",
    "createdAt": "2026-09-29T00:00:00.000Z",
    "updatedAt": "2026-09-29T00:00:00.000Z",
    "createdBy": "SYSTEM_INIT"
  },
  {
    "ruleId": "RULE-FIN-001",
    "version": "1.0",
    "nameBn": "বকেয়া ফি রিমাইন্ডার ও থ্রোটলড অভিভাবক নোটিশ",
    "nameEn": "Overdue Fee Reminder Dispatch",
    "domain": "FINANCE",
    "triggerEvent": "FEE_OVERDUE",
    "conditions": [
      {
        "field": "payload.daysOverdue",
        "operator": "GREATER_THAN",
        "value": 7
      },
      {
        "field": "payload.dueAmount",
        "operator": "GREATER_THAN",
        "value": 0
      }
    ],
    "actions": [
      {
        "actionType": "DISPATCH_NOTIFICATION",
        "target": "GUARDIAN",
        "parameters": {
          "template": "FEE_REMINDER",
          "throttleMinutes": 10080
        },
        "isHighRisk": false
      }
    ],
    "riskLevel": "LOW",
    "requiresApproval": false,
    "status": "ACTIVE",
    "createdAt": "2026-09-29T00:00:00.000Z",
    "updatedAt": "2026-09-29T00:00:00.000Z",
    "createdBy": "SYSTEM_INIT"
  },
  {
    "ruleId": "RULE-INV-001",
    "version": "1.0",
    "nameBn": "মজুদ নিম্নসীমা সতর্কতায় অনুমোদন সাপেক্ষ ক্রয় রিকুয়েস্ট",
    "nameEn": "Low Stock Purchase Request Gate",
    "domain": "INVENTORY",
    "triggerEvent": "STOCK_LOW",
    "conditions": [
      {
        "field": "payload.currentStock",
        "operator": "LESS_THAN_OR_EQUAL",
        "value": "payload.reorderLevel"
      }
    ],
    "actions": [
      {
        "actionType": "REQUEST_HUMAN_APPROVAL",
        "target": "PRINCIPAL",
        "parameters": {
          "action": "CREATE_PURCHASE_REQUEST",
          "role": "PRINCIPAL"
        },
        "isHighRisk": true
      }
    ],
    "riskLevel": "HIGH",
    "requiresApproval": true,
    "status": "ACTIVE",
    "createdAt": "2026-09-29T00:00:00.000Z",
    "updatedAt": "2026-09-29T00:00:00.000Z",
    "createdBy": "SYSTEM_INIT"
  },
  {
    "ruleId": "RULE-OPS-001",
    "version": "1.0",
    "nameBn": "সিস্টেম ব্যাকআপ ব্যর্থতায় ক্রিটিক্যাল অপারেশনাল সতর্কতা",
    "nameEn": "Backup Failure Critical Incident Trigger",
    "domain": "OPERATIONS",
    "triggerEvent": "BACKUP_FAILED",
    "conditions": [
      {
        "field": "payload.status",
        "operator": "EQUALS",
        "value": "FAILED"
      }
    ],
    "actions": [
      {
        "actionType": "CREATE_EARLY_WARNING",
        "target": "OPERATIONS",
        "parameters": {
          "ruleCode": "EW-OPS-001",
          "severity": "CRITICAL"
        },
        "isHighRisk": false
      },
      {
        "actionType": "DISPATCH_NOTIFICATION",
        "target": "ADMIN",
        "parameters": {
          "template": "OPERATIONAL_ALERT",
          "severity": "CRITICAL"
        },
        "isHighRisk": false
      }
    ],
    "riskLevel": "CRITICAL",
    "requiresApproval": false,
    "status": "ACTIVE",
    "createdAt": "2026-09-29T00:00:00.000Z",
    "updatedAt": "2026-09-29T00:00:00.000Z",
    "createdBy": "SYSTEM_INIT"
  }
]